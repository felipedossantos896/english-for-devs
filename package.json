{
  "name": "english-for-devs",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @efd/api db:generate",
    "db:migrate": "pnpm --filter @efd/api db:migrate",
    "db:seed": "pnpm --filter @efd/api db:seed"
  }
}
